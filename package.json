    "test:client": "node --test client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/agents": "^0.20.0",
    "d3": "^7.9.0",
    "openai": "^7.32.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
