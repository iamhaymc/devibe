{
  "name": "devibe",
  "version": "0.1.0",
  "description": "See, check, and reshape large codebases.",
  "type": "module",
  "private": true,
  "bin": {
    "devibe": "server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
