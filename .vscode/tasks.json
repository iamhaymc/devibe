{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "init",
      "type": "shell",
      "command": "./util/setup.sh",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "./util/setup.ps1"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "serve",
      "type": "shell",
      "command": "node app/server.mjs ${input:serveArgs} --open",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "devibe",
        "pattern": {
          "regexp": "a^"
        },
        "background": {
          "activeBegin": "^devibe is running at ",
          "activeEnd": "^devibe is running at "
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "serveArgs",
      "type": "promptString",
      "description": "Folders to serve (space-separated), or --demo",
      "default": "--demo"
    }
  ]
}
